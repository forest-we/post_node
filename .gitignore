# 依赖
node_modules/

# 环境变量（含数据库密码、JWT 密钥，切勿提交）
.env
.env.local
.env.*.local

# 日志
*.log
*.log.err
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 运行时产生的数据
package-lock.json

# 用户上传的文件（运行时数据，不入库）
uploads/*
!uploads/.gitkeep

# 系统 / 编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/

# 临时文件
*.tmp
*.temp
